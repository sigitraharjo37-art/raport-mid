rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profil Identitas Sekolah
    match /schoolInfo/{schoolId} {
      allow read, write: if true;
    }

    // Data Guru
    match /gurus/{guruId} {
      allow read, write: if true;
    }

    // Data Kelas
    match /kelas/{kelasId} {
      allow read, write: if true;
    }

    // Data Mata Pelajaran
    match /mapel/{mapelId} {
      allow read, write: if true;
    }

    // Data Siswa
    match /siswa/{siswaId} {
      allow read, write: if true;
    }

    // Konfigurasi KKTP dan Bobot Mapel
    match /subjectConfigs/{configId} {
      allow read, write: if true;
    }

    // Nilai Formatif & Sumatif
    match /scores/{scoreId} {
      allow read, write: if true;
    }

    // Data Presensi & Catatan Wali Kelas
    match /presensi/{presensiId} {
      allow read, write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
